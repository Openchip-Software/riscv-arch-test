    // cp_ime_vl_not_multiple
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vl_not_multiple : coverpoint (int'(get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl")) % ime_column_vl(ins.hart, ins.issue)) != 0 {
        // VL is not a multiple of lambda*LMUL
        bins not_multiple = {1};
    }

    //// end cp_ime_vl_not_multiple////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vs1_misaligned
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vs1_misaligned : coverpoint ins.current.insn[15] {
        // Odd vs1 register number at LMUL >= 2
        bins odd = {1};
    }

    //// end cp_ime_vs1_misaligned////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vs2_misaligned
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vs2_misaligned : coverpoint ins.current.insn[20] {
        // Odd vs2 register number at LMUL >= 2
        bins odd = {1};
    }

    //// end cp_ime_vs2_misaligned////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vstart
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vstart : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vstart", "vstart") {
        // vstart before an IME instruction: reserved for multiply-accumulate, a resume point for tile loads and stores
        bins one = {1};
        bins above_one = {[2:$]};
    }

    //// end cp_ime_vstart////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vill
    //////////////////////////////////////////////////////////////////////////////////

    cp_vill: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vill") {
        bins one  = {1};
    }

    //// end cp_vill////////////////////////////////////////////////

endgroup
// ---------------------
covergroup ExceptionsZvvm_vwmmacc_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_lmul_fractional
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_lmul_fractional : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul") {
        // Fractional LMUL, which is reserved for IME instructions
        bins f8 = {5};
        bins f4 = {6};
        bins f2 = {7};
    }

    //// end cp_ime_lmul_fractional////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vd_misaligned
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vd_misaligned : coverpoint ins.current.insn[7] {
        // Odd vd (or vs3) register number: misaligned for a register group of 2 or more
        bins odd = {1};
    }

    //// end cp_ime_vd_misaligned////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vl_not_multiple
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vl_not_multiple : coverpoint (int'(get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vl", "vl")) % ime_column_vl(ins.hart, ins.issue)) != 0 {
        // VL is not a multiple of lambda*LMUL
        bins not_multiple = {1};
    }

    //// end cp_ime_vl_not_multiple////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vs1_misaligned
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vs1_misaligned : coverpoint ins.current.insn[15] {
        // Odd vs1 register number at LMUL >= 2
        bins odd = {1};
    }

    //// end cp_ime_vs1_misaligned////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vs2_misaligned
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vs2_misaligned : coverpoint ins.current.insn[20] {
        // Odd vs2 register number at LMUL >= 2
        bins odd = {1};
    }

    //// end cp_ime_vs2_misaligned////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ime_vstart
    //////////////////////////////////////////////////////////////////////////////////

    cp_ime_vstart : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vstart", "vstart") {
        // vstart before an IME instruction: reserved for multiply-accumulate, a resume point for tile loads and stores
        bins one = {1};
        bins above_one = {[2:$]};
    }

    //// end cp_ime_vstart////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vill
    //////////////////////////////////////////////////////////////////////////////////

    cp_vill: coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vill") {
        bins one  = {1};
    }

    //// end cp_vill////////////////////////////////////////////////

endgroup
// ---------------------
function void exceptionszvvm_sample(int hart, int issue, ins_t ins);
    string inst_name = traceDataQ[hart][issue][0].inst_name;

    case (inst_name)
        "v8wmmacc.vv"     : begin
            ExceptionsZvvm_v8wmmacc_vv_cg.sample(ins);
        end
        "vfmmacc.vv"     : begin
            ExceptionsZvvm_vfmmacc_vv_cg.sample(ins);
        end
        "vfqmmacc.vv"     : begin
            ExceptionsZvvm_vfqmmacc_vv_cg.sample(ins);
        end
        "vfwmmacc.vv"     : begin
            ExceptionsZvvm_vfwmmacc_vv_cg.sample(ins);
        end
        "vmmacc.vv"     : begin
            ExceptionsZvvm_vmmacc_vv_cg.sample(ins);
        end
        "vmtl.v"     : begin
            ExceptionsZvvm_vmtl_v_cg.sample(ins);
        end
        "vmts.v"     : begin
            ExceptionsZvvm_vmts_v_cg.sample(ins);
        end
        "vmttl.v"     : begin
            ExceptionsZvvm_vmttl_v_cg.sample(ins);
        end
        "vmtts.v"     : begin
            ExceptionsZvvm_vmtts_v_cg.sample(ins);
        end
        "vqmmacc.vv"     : begin
            ExceptionsZvvm_vqmmacc_vv_cg.sample(ins);
        end
        "vwmmacc.vv"     : begin
            ExceptionsZvvm_vwmmacc_vv_cg.sample(ins);
        end
        default: ; // a case needs at least one item, and some configurations select none
    endcase
endfunction
