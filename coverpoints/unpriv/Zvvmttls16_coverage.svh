`define COVER_ZVVMTTLS16
`define COVER_ZVVMTTLSCUSTOM16
`ifdef UDB_ELEN_16
    `define SEW_16_EQ_ELEN
`endif
`ifdef UDB_ELEN_32
    `define SEW_16_EQ_ELEN_DIV_2
`endif
covergroup Zvvmttls16_vmttl_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.ins_str == "vmttl.v"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_imm_lambda
    //////////////////////////////////////////////////////////////////////////////////

    cp_imm_lambda : coverpoint ins.current.insn[31:29]  iff (ins.trap == 0 )  {
        // Immediate lambda of a tile load or store; 0 uses vtype.lambda
        bins none = {3'b000};
        bins L1   = {3'b001};
        bins L2   = {3'b010};
        bins L4   = {3'b011};
        bins L8   = {3'b100};
        bins L16  = {3'b101};
        bins L32  = {3'b110};
        bins L64  = {3'b111};
    }

    //// end cp_imm_lambda////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_ld
    //////////////////////////////////////////////////////////////////////////////////

    cp_ld : coverpoint ime_ld_check(ins.hart, ins.issue, ins.get_gpr_reg(ins.current.rs2) == x0, ins.current.rs2_val, ins.current.insn[31:29])  iff (ins.trap == 0 )  {
        // Leading dimension LD of a tile load or store, against linesize = lambda*LMUL
        bins x0     = {ime_ld_x0    };   // rs2 = x0: natural LD
        bins zero   = {ime_ld_zero  };   // rs2 holds 0: natural LD
        bins tight  = {ime_ld_tight };   // LD = linesize
        bins padded = {ime_ld_padded};   // LD = linesize + 1
        bins double = {ime_ld_double};   // LD = 2*linesize
    }

    //// end cp_ld////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.get_gpr_reg(ins.current.rs1) iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    cp_rs2 : coverpoint ins.get_gpr_reg(ins.current.rs2)  iff (ins.trap == 0 )  {
        // RS2 register assignment
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_tile_vl
    //////////////////////////////////////////////////////////////////////////////////

    cp_tile_vl : coverpoint vl_check(ins.hart, ins.issue, ime_column_vl(ins.hart, ins.issue))  iff (ins.trap == 0 )  {
        // VL in units of one C column (lambda*LMUL elements)
        bins one_column = {vl_one   };
        bins vlmax      = {vl_vlmax };
        bins legal      = {vl_legal };
    }

    //// end cp_tile_vl////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment
    }

    //// end cp_vd////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_lambda_lmul
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lambda : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "lambda")  iff (ins.trap == 0 )  {
        // Value of VTYPE.lambda, encoded as log2(lambda) + 1
        bins one       = {1};
        bins two       = {2};
        bins four      = {3};
        bins eight     = {4};
        bins sixteen   = {5};
        bins thirtytwo = {6};
        bins sixtyfour = {7};
    }

    cp_csr_vtype_lmul_ime : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 )  {
        // Value of VTYPE.vlmul; IME instructions reserve fractional LMUL
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_vlmax : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // VL = VLMAX
        bins vlmax = {vl_vlmax};
    }

    cr_lambda_lmul : cross cp_csr_vtype_lambda, cp_csr_vtype_lmul_ime, cp_csr_vl_vlmax  iff (ins.trap == 0 )  {
        // Cross coverage of lambda and integer LMUL at VL = VLMAX
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_lambda_lmul////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_tile_vtype_agnostic
    //////////////////////////////////////////////////////////////////////////////////

    cp_vtype_vta_tile : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vta")  iff (ins.trap == 0 )  {
        // VTYPE.vta; a tile load leaves tail elements undisturbed for either value
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cp_vtype_vma_tile : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vma")  iff (ins.trap == 0 )  {
        // VTYPE.vma; a tile load leaves inactive elements undisturbed for either value
        bins undisturbed = {0};
        bins agnostic    = {1};
    }

    cr_tile_vtype_agnostic : cross cp_vtype_vta_tile, cp_vtype_vma_tile  iff (ins.trap == 0 )  {
        // All four combinations of vta and vma on a tile load
    }

    //// end cr_tile_vtype_agnostic////////////////////////////////////////////////

endgroup
