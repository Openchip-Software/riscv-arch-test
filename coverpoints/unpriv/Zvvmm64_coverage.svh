        bins maxm1      = {vs_maxm1     };   //  = {{1'b0}, (`SEW-2){1'b1}, {1'b0}},
        bins ones       = {vs_ones      };   //  = {(`SEW){1'b1}},
        bins onesm1     = {vs_onesm1    };   //  = {(`SEW-1){1'b1}, {1'b0}},
        bins walkodd    = {vs_walkodd   };   //  = {(`SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(SEW){random}}
    }

    //// end cp_vs2_edges////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_lambda_lmul
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lambda : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "lambda")  iff (ins.trap == 0 )  {
        // Value of VTYPE.lambda, encoded as log2(lambda) + 1
        bins one       = {1};
        bins two       = {2};
        bins four      = {3};
        bins eight     = {4};
        bins sixteen   = {5};
        bins thirtytwo = {6};
        bins sixtyfour = {7};
    }

    cp_csr_vtype_lmul_ime : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 )  {
        // Value of VTYPE.vlmul; IME instructions reserve fractional LMUL
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_vlmax : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // VL = VLMAX
        bins vlmax = {vl_vlmax};
    }

    cr_lambda_lmul : cross cp_csr_vtype_lambda, cp_csr_vtype_lmul_ime, cp_csr_vl_vlmax  iff (ins.trap == 0 )  {
        // Cross coverage of lambda and integer LMUL at VL = VLMAX
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_lambda_lmul////////////////////////////////////////////////

endgroup
// ---------------------
`endif
`ifdef ZVVI64MM_SUPPORTED
`ifdef ZVVMTLS_SUPPORTED
covergroup Zvvmm64Zvvi64mmZvvmtls_vmmacc_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_tile_macc
    //////////////////////////////////////////////////////////////////////////////////

    cp_tile_macc_lambda : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "lambda")  iff (ins.trap == 0 )  {
        // VTYPE.lambda of a multiply-accumulate whose A and B come from tile loads
        bins one       = {1};
        bins two       = {2};
        bins four      = {3};
        bins eight     = {4};
        bins sixteen   = {5};
        bins thirtytwo = {6};
        bins sixtyfour = {7};
    }

    cp_tile_macc_lmul : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 )  {
        // VTYPE.vlmul of the multiply-accumulate (the tile LMUL of A and B)
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_custom_tile_macc : cross cp_tile_macc_lambda, cp_tile_macc_lmul  iff (ins.trap == 0 )  {
        // Multiply-accumulate with tile-loaded A and B and a tile-stored C, for each lambda and LMUL
    }

    //// end cp_custom_tile_macc////////////////////////////////////////////////

endgroup
// ---------------------
`endif
`endif
`ifdef ZVVI8I64MM_SUPPORTED
covergroup Zvvmm64Zvvi8i64mm_v8wmmacc_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_altfmt
    //////////////////////////////////////////////////////////////////////////////////

    cp_vtype_altfmt_a : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_a")  iff (ins.trap == 0 )  {
        // VTYPE.altfmt_A; for integer multiply-accumulate, 1 makes A unsigned
        bins signed_a   = {0};
        bins unsigned_a = {1};
    }

    cp_vtype_altfmt_b : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_b")  iff (ins.trap == 0 )  {
        // VTYPE.altfmt_B; for integer multiply-accumulate, 1 makes B unsigned
        bins signed_b   = {0};
        bins unsigned_b = {1};
    }

    cp_altfmt : cross cp_vtype_altfmt_a, cp_vtype_altfmt_b  iff (ins.trap == 0 )  {
        // All four signedness combinations of A and B
    }

    //// end cp_altfmt////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "v8wmmacc.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_tile_vl
    //////////////////////////////////////////////////////////////////////////////////

    cp_tile_vl : coverpoint vl_check(ins.hart, ins.issue, ime_column_vl(ins.hart, ins.issue))  iff (ins.trap == 0 )  {
        // VL in units of one C column (lambda*LMUL elements)
        bins one_column = {vl_one   };
        bins vlmax      = {vl_vlmax };
        bins legal      = {vl_legal };
    }

    //// end cp_tile_vl////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges : coverpoint vs_edges_check(ins.hart, ins.issue, ins.current.vd_val_pre, "1")  iff (ins.trap == 0 )  {
        // Edge values of vd before the instruction (the accumulator input), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`SEW){1'b0}},
        bins one        = {vs_one       };   //  = {(`SEW-1){1'b0}, {1'b1}},
        bins two        = {vs_two       };   //  = {(`SEW-2){1'b0}, {2'b10}},
        bins min        = {vs_min       };   //  = {{1'b1}, (`SEW-1){1'b0}},
        bins minp1      = {vs_minp1     };   //  = {{1'b1}, (`SEW-2){1'b0}, {1'b1}},
        bins max        = {vs_max       };   //  = {{1'b0}, (`SEW-1){1'b1}},
        bins maxm1      = {vs_maxm1     };   //  = {{1'b0}, (`SEW-2){1'b1}, {1'b0}},
        bins ones       = {vs_ones      };   //  = {(`SEW){1'b1}},
        bins onesm1     = {vs_onesm1    };   //  = {(`SEW-1){1'b1}, {1'b0}},
        bins walkodd    = {vs_walkodd   };   //  = {(`SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(SEW){random}}
    }

    //// end cp_vd_edges////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_emul16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_emul16 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment for a C register window of 16 registers, which fits every VLEN
        bins v0  = {v0};
        bins v16 = {v16};
    }

    //// end cp_vd_emul16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.trap == 0 )  {
        // VS1 register assignment
    }

    //// end cp_vs1////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_edges_emulf8
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_edges_emulf8 : coverpoint vs_edges_check(ins.hart, ins.issue, ins.current.vs1_val, "f8")  iff (ins.trap == 0 )  {
        // Edges values of vs1 (emul = f8), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`SEW){1'b0}},
        bins one        = {vs_one       };   //  = {(`SEW-1){1'b0}, {1'b1}},
        bins two        = {vs_two       };   //  = {(`SEW-2){1'b0}, {2'b10}},
        bins min        = {vs_min       };   //  = {{1'b1}, (`SEW-1){1'b0}},
        bins minp1      = {vs_minp1     };   //  = {{1'b1}, (`SEW-2){1'b0}, {1'b1}},
        bins max        = {vs_max       };   //  = {{1'b0}, (`SEW-1){1'b1}},
        bins maxm1      = {vs_maxm1     };   //  = {{1'b0}, (`SEW-2){1'b1}, {1'b0}},
        bins ones       = {vs_ones      };   //  = {(`SEW){1'b1}},
        bins onesm1     = {vs_onesm1    };   //  = {(`SEW-1){1'b1}, {1'b0}},
        bins walkodd    = {vs_walkodd   };   //  = {(`SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(SEW){random}}
    }

    //// end cp_vs1_edges_emulf8////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_emulf8
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_emulf8 : coverpoint vs_edges_check(ins.hart, ins.issue, ins.current.vs2_val, "f8")  iff (ins.trap == 0 )  {
        // Edges values of vs2 (emul = f8), assuming vl = 1
        bins zero       = {vs_zero      };   //  = {(`SEW){1'b0}},
        bins one        = {vs_one       };   //  = {(`SEW-1){1'b0}, {1'b1}},
        bins two        = {vs_two       };   //  = {(`SEW-2){1'b0}, {2'b10}},
        bins min        = {vs_min       };   //  = {{1'b1}, (`SEW-1){1'b0}},
        bins minp1      = {vs_minp1     };   //  = {{1'b1}, (`SEW-2){1'b0}, {1'b1}},
        bins max        = {vs_max       };   //  = {{1'b0}, (`SEW-1){1'b1}},
        bins maxm1      = {vs_maxm1     };   //  = {{1'b0}, (`SEW-2){1'b1}, {1'b0}},
        bins ones       = {vs_ones      };   //  = {(`SEW){1'b1}},
        bins onesm1     = {vs_onesm1    };   //  = {(`SEW-1){1'b1}, {1'b0}},
        bins walkodd    = {vs_walkodd   };   //  = {(`SEW/2){2'b10}},
        bins walkeven   = {vs_walkeven  };   //  = {(`SEW/2){2'b01}},
        bins random     = {vs_random    };   //  = {(SEW){random}}
    }

    //// end cp_vs2_edges_emulf8////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_lambda_lmul
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lambda : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "lambda")  iff (ins.trap == 0 )  {
        // Value of VTYPE.lambda, encoded as log2(lambda) + 1
        bins one       = {1};
        bins two       = {2};
        bins four      = {3};
        bins eight     = {4};
        bins sixteen   = {5};
        bins thirtytwo = {6};
        bins sixtyfour = {7};
    }

    cp_csr_vtype_lmul_ime : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 )  {
        // Value of VTYPE.vlmul; IME instructions reserve fractional LMUL
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_vlmax : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // VL = VLMAX
        bins vlmax = {vl_vlmax};
    }

    cr_lambda_lmul : cross cp_csr_vtype_lambda, cp_csr_vtype_lmul_ime, cp_csr_vl_vlmax  iff (ins.trap == 0 )  {
        // Cross coverage of lambda and integer LMUL at VL = VLMAX
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_lambda_lmul////////////////////////////////////////////////

endgroup
// ---------------------
`endif
function void zvvmm64_sample(int hart, int issue, ins_t ins);
    string inst_name = traceDataQ[hart][issue][0].inst_name;

    // Want to sample only if the SEW matches the target SEW of the file, some tests require
    // testing when vill is set, if vill=1 all other vtype bits are set to 0 so there is no
    // associated sew with these tests
    if (get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vsew") == 3 ||
        get_csr_val(hart, issue, `SAMPLE_BEFORE, "vtype", "vill") == 1) begin
        case (inst_name)
`ifdef ZVVI8I64MM_SUPPORTED
        "v8wmmacc.vv"     : begin
            Zvvmm64Zvvi8i64mm_v8wmmacc_vv_cg.sample(ins);
        end
`endif
        "vmmacc.vv"     : begin
`ifdef ZVVI64MM_SUPPORTED
            Zvvmm64Zvvi64mm_vmmacc_vv_cg.sample(ins);
`endif
`ifdef ZVVI64MM_SUPPORTED
`ifdef ZVVMTLS_SUPPORTED
            Zvvmm64Zvvi64mmZvvmtls_vmmacc_vv_cg.sample(ins);
`endif
`endif
        end
`ifdef ZVVI16I64MM_SUPPORTED
        "vqmmacc.vv"     : begin
            Zvvmm64Zvvi16i64mm_vqmmacc_vv_cg.sample(ins);
        end
`endif
`ifdef ZVVI32I64MM_SUPPORTED
        "vwmmacc.vv"     : begin
            Zvvmm64Zvvi32i64mm_vwmmacc_vv_cg.sample(ins);
        end
`endif
            default: ; // a case needs at least one item, and some configurations select none
        endcase
    end
endfunction
