        bins pos1p5                 = {16'h3FC0};
        bins neg2                   = {16'hC000};
        bins pi                     = {16'h4049};
        bins twoToEmax              = {16'h7f00};
        bins onePulp                = {16'h3f81};
        bins largestsubnorm         = {16'h007F};
        bins negSubnormLeadingOne   = {16'h8040};
        bins min_subnorm            = {16'h0001};
        bins canonicalQNaN          = {16'h7FC0};                // Quiet NaN with only MSB of fraction set
        bins negNoncanonicalQNaN    = {[16'hFFC1:16'hFFFF]};     // Quiet NaNs excluding canonical
        bins sNaN_payload1          = {16'h7F81};                // Signaling NaN with payload 1
    }

    //// end cp_vd_edges_f_bf16_sew16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_emul16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_emul16 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment for a C register window of 16 registers, which fits every VLEN
        bins v0  = {v0};
        bins v16 = {v16};
    }

    //// end cp_vd_emul16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1 : coverpoint ins.get_vr_reg(ins.current.vs1)  iff (ins.trap == 0 )  {
        // VS1 register assignment
    }

    //// end cp_vs1////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs1_edges_f_ofp8_sew16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs1_edges_f_ofp8_e4m3_sew16 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs1_val)[7:0]  iff (ins.trap == 0 && get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_a") == 0)  {
        // (OFP8 E4M3, vtype.altfmt_A = 0)
        bins pos0                     = {8'h00};
        bins neg0                     = {8'h80};
        bins pos1                     = {8'h38};
        bins neg1                     = {8'hB8};
        bins posminnorm               = {8'h08};
        bins posmaxnorm               = {8'h7E};
        bins negmaxnorm               = {8'hFE};
        bins pos0p5                   = {8'h30};
        bins pos1p5                   = {8'h3C};
        bins neg2                     = {8'hC0};
        bins twoToEmax                = {8'h78};
        bins onePulp                  = {8'h39};
        bins largestsubnorm           = {8'h07};
        bins negSubnormLeadingOne     = {8'h84};
        bins min_subnorm              = {8'h01};
        bins posNaN                   = {8'h7F};
        bins negNaN                   = {8'hFF};
    }

    cp_vs1_edges_f_ofp8_e5m2_sew16 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs1_val)[7:0]  iff (ins.trap == 0 && get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_a") == 1)  {
        // (OFP8 E5M2, vtype.altfmt_A = 1)
        bins pos0                     = {8'h00};
        bins neg0                     = {8'h80};
        bins pos1                     = {8'h3C};
        bins neg1                     = {8'hBC};
        bins posminnorm               = {8'h04};
        bins posmaxnorm               = {8'h7B};
        bins negmaxnorm               = {8'hFB};
        bins posinfinity              = {8'h7C};
        bins neginfinity              = {8'hFC};
        bins pos0p5                   = {8'h38};
        bins pos1p5                   = {8'h3E};
        bins neg2                     = {8'hC0};
        bins twoToEmax                = {8'h78};
        bins onePulp                  = {8'h3D};
        bins largestsubnorm           = {8'h03};
        bins negSubnormLeadingOne     = {8'h82};
        bins min_subnorm              = {8'h01};
        bins canonicalQNaN            = {8'h7E};
        bins negNoncanonicalQNaN      = {8'hFF};
        bins sNaN_payload1            = {8'h7D};
    }

    //// end cp_vs1_edges_f_ofp8_sew16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.get_vr_reg(ins.current.vs2)  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_f_ofp8_sew16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_f_ofp8_e4m3_sew16 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val)[7:0]  iff (ins.trap == 0 && get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_b") == 0)  {
        // (OFP8 E4M3, vtype.altfmt_B = 0)
        bins pos0                     = {8'h00};
        bins neg0                     = {8'h80};
        bins pos1                     = {8'h38};
        bins neg1                     = {8'hB8};
        bins posminnorm               = {8'h08};
        bins posmaxnorm               = {8'h7E};
        bins negmaxnorm               = {8'hFE};
        bins pos0p5                   = {8'h30};
        bins pos1p5                   = {8'h3C};
        bins neg2                     = {8'hC0};
        bins twoToEmax                = {8'h78};
        bins onePulp                  = {8'h39};
        bins largestsubnorm           = {8'h07};
        bins negSubnormLeadingOne     = {8'h84};
        bins min_subnorm              = {8'h01};
        bins posNaN                   = {8'h7F};
        bins negNaN                   = {8'hFF};
    }

    cp_vs2_edges_f_ofp8_e5m2_sew16 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val)[7:0]  iff (ins.trap == 0 && get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_b") == 1)  {
        // (OFP8 E5M2, vtype.altfmt_B = 1)
        bins pos0                     = {8'h00};
        bins neg0                     = {8'h80};
        bins pos1                     = {8'h3C};
        bins neg1                     = {8'hBC};
        bins posminnorm               = {8'h04};
        bins posmaxnorm               = {8'h7B};
        bins negmaxnorm               = {8'hFB};
        bins posinfinity              = {8'h7C};
        bins neginfinity              = {8'hFC};
        bins pos0p5                   = {8'h38};
        bins pos1p5                   = {8'h3E};
        bins neg2                     = {8'hC0};
        bins twoToEmax                = {8'h78};
        bins onePulp                  = {8'h3D};
        bins largestsubnorm           = {8'h03};
        bins negSubnormLeadingOne     = {8'h82};
        bins min_subnorm              = {8'h01};
        bins canonicalQNaN            = {8'h7E};
        bins negNoncanonicalQNaN      = {8'hFF};
        bins sNaN_payload1            = {8'h7D};
    }

    //// end cp_vs2_edges_f_ofp8_sew16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_lambda_lmul
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lambda : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "lambda")  iff (ins.trap == 0 )  {
        // Value of VTYPE.lambda, encoded as log2(lambda) + 1
        bins one       = {1};
        bins two       = {2};
        bins four      = {3};
        bins eight     = {4};
        bins sixteen   = {5};
        bins thirtytwo = {6};
        bins sixtyfour = {7};
    }

    cp_csr_vtype_lmul_ime : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "vlmul")  iff (ins.trap == 0 )  {
        // Value of VTYPE.vlmul; IME instructions reserve fractional LMUL
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_vlmax : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // VL = VLMAX
        bins vlmax = {vl_vlmax};
    }

    cr_lambda_lmul : cross cp_csr_vtype_lambda, cp_csr_vtype_lmul_ime, cp_csr_vl_vlmax  iff (ins.trap == 0 )  {
        // Cross coverage of lambda and integer LMUL at VL = VLMAX
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_lambda_lmul////////////////////////////////////////////////

endgroup
