`ifdef ZVVOFP8FP16MM_SUPPORTED
covergroup Zvvfmm16Zvvofp8fp16mm_vfwmmacc_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_altfmt_ofp8
    //////////////////////////////////////////////////////////////////////////////////

    cp_vtype_altfmt_a_ofp8 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_a")  iff (ins.trap == 0 )  {
        // VTYPE.altfmt_A; for OFP8 inputs, 1 selects E5M2 for A
        bins e4m3_a = {0};
        bins e5m2_a = {1};
    }

    cp_vtype_altfmt_b_ofp8 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_b")  iff (ins.trap == 0 )  {
        // VTYPE.altfmt_B; for OFP8 inputs, 1 selects E5M2 for B
        bins e4m3_b = {0};
        bins e5m2_b = {1};
    }

    cp_altfmt_ofp8 : cross cp_vtype_altfmt_a_ofp8, cp_vtype_altfmt_b_ofp8  iff (ins.trap == 0 )  {
        // All four OFP8 format combinations of A and B
    }

    //// end cp_altfmt_ofp8////////////////////////////////////////////////

    cp_asm_count : coverpoint ins.ins_str == "vfwmmacc.vv"  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    cp_csr_fflags_voun : coverpoint {
        get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "fflags")[4:0],
        get_csr_val(ins.hart, ins.issue, `SAMPLE_AFTER, "fcsr", "fflags")[4:0]
    } iff (ins.trap == 0 )  {
        // Value of FCSR.fflags
        wildcard bins NV   = {10'b0????_1????};
        wildcard bins NV1  = {10'b1????_1????};
        wildcard bins OF   = {10'b??0??_??1??};
        wildcard bins OF1  = {10'b??1??_??1??};
        wildcard bins UF   = {10'b???0?_???1?};
        wildcard bins UF1  = {10'b???1?_???1?};
        wildcard bins NX   = {10'b????0_????1};
        wildcard bins NX1  = {10'b????1_????1};
    }

    cp_csr_frm_v : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "frm")  iff (ins.trap == 0 )  {
        // Value of FCSR.frm for vector FP instructions, which do not specify dynamic rounding mode in opcode
        bins rne  = {3'b000};
        bins rtz  = {3'b001};
        bins rdn  = {3'b010};
        bins rup  = {3'b011};
        bins rmm  = {3'b100};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_fp_rnd
    //////////////////////////////////////////////////////////////////////////////////

    cp_fp_rnd : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "frm")  iff (ins.trap == 0 )  {
        // FCSR.frm for a multiply-accumulate whose partial sum is not exact in the C format (disclosed rnd = frm)
        bins frm_rne = {3'b000};
        bins frm_rtz = {3'b001};
        bins frm_rdn = {3'b010};
        bins frm_rup = {3'b011};
        bins frm_rmm = {3'b100};
    }

    //// end cp_fp_rnd////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_fp_subdot
    //////////////////////////////////////////////////////////////////////////////////

    cp_fp_subdot : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "fcsr", "frm")  iff (ins.trap == 0 )  {
        // FCSR.frm for a widening multiply-accumulate whose W products add up to one ULP of C
        bins ulp_rne = {3'b000};
        bins ulp_rtz = {3'b001};
        bins ulp_rdn = {3'b010};
        bins ulp_rup = {3'b011};
        bins ulp_rmm = {3'b100};
    }

    //// end cp_fp_subdot////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_tile_vl
    //////////////////////////////////////////////////////////////////////////////////

    cp_tile_vl : coverpoint vl_check(ins.hart, ins.issue, ime_column_vl(ins.hart, ins.issue))  iff (ins.trap == 0 )  {
        // VL in units of one C column (lambda*LMUL elements)
        bins one_column = {vl_one   };
        bins vlmax      = {vl_vlmax };
        bins legal      = {vl_legal };
    }

    //// end cp_tile_vl////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_edges_f_sew16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_edges_f_sew16 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vd_val_pre)[15:0]  iff (ins.trap == 0 )  {
        // (Half Precision)
        bins pos0                   = {16'h0000};
        bins neg0                   = {16'h8000};
        bins pos1                   = {16'h3C00};
        bins neg1                   = {16'hBC00};
        bins posminnorm             = {16'h0400};
        bins negmaxnorm             = {16'hFBFF};
        bins posinfinity            = {16'h7C00};
        bins neginfinity            = {16'hFC00};
        bins pos0p5                 = {16'h3800};
        bins pos1p5                 = {16'h3E00};
        bins neg2                   = {16'hC000};
        bins pi                     = {16'h4248};
        bins twoToEmax              = {16'h7800};
        bins onePulp                = {16'h3c01};
        bins largestsubnorm         = {16'h03FF};
        bins negSubnormLeadingOne   = {16'h8200};
        bins min_subnorm            = {16'h0001};
        bins canonicalQNaN          = {16'h7E00};                // Quiet NaN with only MSB of fraction set
        bins negNoncanonicalQNaN    = {[16'hFE01:16'hFFFF]};     // Quiet NaNs excluding canonical
        bins sNaN_payload1          = {16'h7D01};                // Signaling NaN with payload 1
    }

    //// end cp_vd_edges_f_sew16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_emul16
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_emul16 : coverpoint ins.get_vr_reg(ins.current.vd)  iff (ins.trap == 0 )  {
        // VD register assignment for a C register window of 16 registers, which fits every VLEN
        bins v0  = {v0};
        bins v16 = {v16};
    }

    //// end cp_vd_emul16////////////////////////////////////////////////

