    cp_vs2_edges_f_ofp8_e5m2_sew64 : coverpoint get_vr_element_zero(ins.hart, ins.issue, ins.current.vs2_val)[7:0]  iff (ins.trap == 0 && get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, "vtype", "altfmt_b") == 1)  {
