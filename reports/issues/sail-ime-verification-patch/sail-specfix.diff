+// Scratch verification patch: C can span 16 registers (EMUL_C=16), but read_single_element and
+// write_single_element assert a group of at most 8. Address the upper 8 registers as a second group.
+val ime_read_c : forall 'sew, is_sew_bitsize('sew) . (int('sew), nat, vregidx) -> bits('sew)
+function ime_read_c(EEW, index, vd) = {
+  let half : nat = 8 * (vlen / EEW);
+  if index >= half then {
+    let lo : nat = index - half;
+    read_single_element(EEW, lo, vd + 8)
+  } else read_single_element(EEW, index, vd)
+}
+
+val ime_write_c : forall 'sew, is_sew_bitsize('sew) . (int('sew), nat, vregidx, bits('sew)) -> unit
+function ime_write_c(EEW, index, vd, value) = {
+  let half : nat = 8 * (vlen / EEW);
+  if index >= half then {
+    let lo : nat = index - half;
+    write_single_element(EEW, lo, vd + 8, value)
+  } else write_single_element(EEW, index, vd, value)
+}
+
